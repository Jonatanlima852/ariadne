# ── Go ────────────────────────────────────────
# Binários compilados
runtime/bin/
*.exe
*.test

# Cache de build e test
runtime/.cache/

# Vendor (dependências copiadas localmente — não usamos por ora)
runtime/vendor/

# Cobertura de testes
*.out
coverage.html

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# Ambientes virtuais
.venv/
venv/
env/

# Distribuição / empacotamento
dist/
build/
node_modules/
*.egg-info/
*.egg

# ── Código gerado pelo protoc ─────────────────
# Optamos por NÃO ignorar runtime/gen/ e sdk/python/src/
# para que o repo seja utilizável sem precisar rodar "make proto".
# Se preferir regenerar sempre, descomente as linhas abaixo:
# runtime/gen/
# sdk/python/src/contract/

# ── Resultados de studies/benchmarks ──────────────────
# Mantém a estrutura de pastas mas ignora arquivos de dados
studies/runtime_metrics/results/*.jsonl
studies/runtime_metrics/results/*.json
studies/runtime_metrics/results/*.csv
studies/runtime_metrics/results/*.png
!studies/runtime_metrics/results/.gitkeep
studies/benchmarks/results/*
!studies/benchmarks/results/README.md

# ── Variáveis de ambiente ─────────────────────
.env
.env.*
!.env.example

# ── Sistema operacional ───────────────────────
.DS_Store
Thumbs.db

# ── Editores / IDEs ───────────────────────────
.idea/
.vscode/
*.swp
*.swo

# Notas internas de aprendizado e acompanhamento
CLAUDE.md
/internal-notes/
/.tg/
