#!/bin/sh
# Bootstrap do checkout. Semântica e argumentos pertencem à CLI Python.
set -eu
TG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TG_RUNTIME_SOURCE=${TG_RUNTIME_SOURCE:-"$TG_ROOT/runtime"}
TG_RUNS_DIR=${TG_RUNS_DIR:-"$TG_ROOT/.tg/runs"}
export TG_ROOT TG_RUNTIME_SOURCE TG_RUNS_DIR
if [ -n "${TG_PYTHON:-}" ]; then
    exec "$TG_PYTHON" -m tg_sdk "$@"
fi
if ! command -v uv >/dev/null 2>&1; then
    printf 'Erro: instale uv ou configure TG_PYTHON com um Python que tenha tg-sdk.\n' >&2
    exit 1
fi
if [ -n "${TG_SDK_EXTRAS:-}" ]; then
    exec uv run --project "$TG_ROOT/sdk/python" --extra "$TG_SDK_EXTRAS" python -m tg_sdk "$@"
fi
exec uv run --project "$TG_ROOT/sdk/python" python -m tg_sdk "$@"
