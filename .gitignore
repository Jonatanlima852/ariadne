# ── Go ────────────────────────────────────────
*.exe
*.test

# Cobertura de testes
*.out
coverage.html

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# Ambientes virtuais
.venv/
venv/
env/

# Distribuição / empacotamento
dist/
build/
node_modules/
*.egg-info/
*.egg

# ── Código gerado pelo protoc ─────────────────
# Optamos por NÃO ignorar runtime/gen/ e sdk/python/src/
# para que o repo seja utilizável sem precisar rodar "make proto".
# Se preferir regenerar sempre, descomente as linhas abaixo:
# runtime/gen/
# sdk/python/src/contract/

# Execuções locais ficam ao lado de cada scenario.py; coletas preservadas vão para results/.
studies/scenarios/**/runs/
studies/scenarios/**/campaigns/

# Resultados locais pertencem a cada cenário.
studies/scenarios/*/runtime_metrics/results/*
!studies/scenarios/*/runtime_metrics/results/README.md

# Logística v2: apenas coleções selecionadas entram no versionamento.
# Os caminhos existentes são preservados por proveniência.
studies/scenarios/logistics/v2/results/*
!studies/scenarios/logistics/v2/results/README.md
!studies/scenarios/logistics/v2/results/summary.json
!studies/scenarios/logistics/v2/results/demo/
!studies/scenarios/logistics/v2/results/real/
!studies/scenarios/logistics/v2/results/lean-development/
!studies/scenarios/logistics/v2/results/stress-demo/
!studies/scenarios/logistics/v2/results/stress-original-partial/
!studies/scenarios/logistics/v2/results/stress-lean/
!studies/scenarios/logistics/v2/results/presentation/

# ── Variáveis de ambiente ─────────────────────
.env
.env.*
!.env.example

# ── Sistema operacional ───────────────────────
.DS_Store
Thumbs.db

# ── Editores / IDEs ───────────────────────────
.idea/
.vscode/
*.swp
*.swo

