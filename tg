#!/bin/sh
# Entrada pública: somente shell POSIX e Docker são necessários no host.
set -eu
TG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export TG_ROOT
RUNS=${TG_RUNS_DIR:-"$TG_ROOT/.tg/runs"}
case "$RUNS" in /*) ;; *) RUNS="$PWD/$RUNS" ;; esac
STATE=$(dirname -- "$RUNS")

die() { printf 'Erro: %s\n' "$*" >&2; exit 1; }
help() {
    cat <<'EOF'
TG Runtime — executar, observar e encerrar cenários

  ./tg help
  ./tg run arquivo.py [opções]     executa uma descrição local (Go e uv)
  ./tg check arquivo.py            valida a descrição sem iniciar serviços
  ./tg doctor [cenário]             verifica Docker e configuração, sem iniciar
  ./tg demo [--keep]                tarefa básica, sem LLM
  ./tg scenario [nome] [--keep]     lista ou executa os cenários abaixo
  ./tg logs [execução]              logs da execução; padrão: última
  ./tg status [execução]            estado e diretório dos resultados
  ./tg stop [execução]              exporta dados e encerra somente essa execução

Cenários: demo, workflow-sequential, failure-reassignment, messaging-basic,
          heterogeneous-route, logistics-mission

Por padrão, o ambiente é encerrado após executar, inclusive em falha.
--keep mantém os serviços para inspeção com logs/status/stop.
Cada execução usa rede e volume próprios, sem publicar portas no host.
Resultados: .tg/runs/<execução>/ (a pasta .tg é local e ignorada pelo Git).

LLM: configure OPENAI_API_KEY no ambiente ou em .env; TG_ENV_FILE escolhe
outro arquivo (caminho relativo à raiz do repo). O cenário de rota também
aceita scenarios/heterogeneous-route/.env. A execução real pode gerar custos.
TG_READY_TIMEOUT=90 limita a espera por prontidão; TG_SCENARIO_TIMEOUT=180
limita o cenário (segundos). Docker Compose >=2.24.4 é necessário.
EOF
}

select_scenario() {
    scenario=$1
    llm=no
    case "$scenario" in
        demo) base=infra/docker-compose.yml; services='registry orchestrator mock-agent' ;;
        workflow-sequential) base=scenarios/workflow-sequential/compose.yaml; services='registry orchestrator echo-agent' ;;
        failure-reassignment) base=scenarios/failure-reassignment/compose.yaml; services='registry orchestrator slow-agent healthy-agent' ;;
        messaging-basic) base=scenarios/messaging-basic/compose.yaml; services=messaging ;;
        heterogeneous-route) base=scenarios/heterogeneous-route/compose.yaml; services='registry orchestrator bdi-agent llm-agent'; llm=yes ;;
        logistics-mission) base=benchmarks/compose.yaml; services='registry orchestrator bdi-agent llm-agent'; llm=yes ;;
        *) die "Cenário desconhecido: $scenario. Consulte ./tg scenario." ;;
    esac
    env_file=/dev/null
    if [ "$llm" = yes ]; then
        if [ -n "${TG_ENV_FILE:-}" ]; then
            case "$TG_ENV_FILE" in /*) env_file=$TG_ENV_FILE ;; *) env_file="$TG_ROOT/$TG_ENV_FILE" ;; esac
            [ -f "$env_file" ] || die "TG_ENV_FILE não encontrado: $env_file"
        elif [ "$scenario" = heterogeneous-route ] && [ -f "$TG_ROOT/scenarios/heterogeneous-route/.env" ]; then
            env_file="$TG_ROOT/scenarios/heterogeneous-route/.env"
        elif [ -f "$TG_ROOT/.env" ]; then
            env_file="$TG_ROOT/.env"
        fi
    fi
}

check_tools() {
    command -v docker >/dev/null 2>&1 || die 'Docker não encontrado. Instale e inicie o Docker.'
    version=$(docker compose version --short 2>/dev/null) || die 'Docker Compose v2 não disponível.'
    printf '%s\n' "$version" | awk -F. '{gsub(/^v/, "", $1); exit !(($1+0>2)||($1+0==2 && ($2+0>24 || ($2+0==24 && $3+0>=4))))}' \
        || die "Docker Compose $version: é necessário >=2.24.4."
    docker info >/dev/null 2>&1 || die 'Docker indisponível. Inicie o daemon e confira seu acesso com docker info.'
}

timeout_value() {
    case "$2" in ''|*[!0-9]*) die "$1 deve ser um inteiro entre 1 e 3600." ;; esac
    [ "$2" -ge 1 ] && [ "$2" -le 3600 ] || die "$1 deve estar entre 1 e 3600."
}

# A descrição de controle não contém ambiente/credenciais nem caminhos de build.
# Ela permite logs/down mesmo se a configuração LLM tiver sido removida.
configuration() {
    printf 'services:\n' > "$run_dir/override.yaml"
    printf 'services:\n' > "$run_dir/control.yaml"
    for service in $services; do
        printf '  %s:\n    ports: !reset []\n    restart: on-failure\n' "$service" >> "$run_dir/override.yaml"
        printf '  %s:\n    image: scratch\n' "$service" >> "$run_dir/control.yaml"
        case "$service" in
            orchestrator|messaging) printf '    volumes:\n      - events_data:/data\n' >> "$run_dir/control.yaml" ;;
        esac
    done
    printf '  runner:\n    image: scratch\nvolumes:\n  events_data: {}\n' >> "$run_dir/control.yaml"
}

compose() {
    docker compose --env-file "$env_file" -p "$project" \
        -f "$TG_ROOT/$base" -f "$run_dir/override.yaml" \
        -f "$TG_ROOT/scripts/launcher/runner.compose.yaml" "$@"
}

control() {
    docker compose --env-file /dev/null -p "$project" -f "$run_dir/control.yaml" "$@"
}

doctor() (
    select_scenario "$1"
    check_tools
    run_dir=$(mktemp -d "${TMPDIR:-/tmp}/tg-doctor.XXXXXX")
    trap 'rm -rf -- "$run_dir"' EXIT
    project=tg-doctor
    TG_RUN_DIR=$run_dir
    export TG_RUN_DIR
    configuration
    compose config --quiet || die 'Configuração inválida. Para LLM, confira OPENAI_API_KEY e TG_ENV_FILE.'
    printf 'OK: Docker e Compose %s; cenário %s configurado.\n' "$version" "$scenario"
    printf 'Cliente em contêiner; nenhuma porta publicada no host.\n'
    [ "$llm" = no ] || printf 'A configuração LLM existe; acesso ao modelo só é verificado na execução real.\n'
)

load_run() {
    run_id=${1:-latest}
    case "$run_id" in
        */*)
            [ "$command" != stop ] || die 'Use o ID para encerrar uma execução Docker.'
            [ -d "$run_id" ] || die "Execução não encontrada: $run_id"
            run_dir=$(CDPATH= cd -- "$run_id" && pwd)
            run_id=${run_dir##*/}
            ;;
        *) run_dir= ;;
    esac
    if [ "$run_id" = latest ]; then
        [ -f "$STATE/latest" ] || die 'Nenhuma execução registrada. Use ./tg run ou ./tg demo.'
        run_id=$(cat "$STATE/latest")
    fi
    case "$run_id" in tg-*) ;; *) die 'Identificador de execução inválido.' ;; esac
    case "$run_id" in *[!a-zA-Z0-9-]*) die 'Identificador de execução inválido.' ;; esac
    run_dir=${run_dir:-"$RUNS/$run_id"}
    [ -f "$run_dir/status" ] && [ -f "$run_dir/scenario" ] || die "Execução não encontrada: $run_id"
    backend=local-processes
    if [ -f "$run_dir/control.yaml" ]; then backend=docker; fi
    project=$(printf '%s' "$run_id" | tr '[:upper:]' '[:lower:]')
}

collect() {
    export_complete=yes
    if control logs --no-color > "$run_dir/services.log.tmp" 2>> "$run_dir/diagnostics.log"; then
        if [ -s "$run_dir/services.log.tmp" ]; then mv "$run_dir/services.log.tmp" "$run_dir/services.log"; fi
    fi
    rm -f "$run_dir/services.log.tmp"
    # Nunca substituir um arquivo já exportado por uma tentativa vazia após down.
    for service in orchestrator messaging; do
        grep -q "^  $service:" "$run_dir/control.yaml" || continue
        case "$service" in orchestrator) filename=events.jsonl ;; messaging) filename=message-events.jsonl ;; esac
        if control cp "$service:/data/$filename" "$run_dir/$filename.tmp" >> "$run_dir/diagnostics.log" 2>&1; then
            mv "$run_dir/$filename.tmp" "$run_dir/$filename"
        else
            rm -f "$run_dir/$filename.tmp"
            export_complete=no
        fi
    done
    return 0
}

shutdown() {
    volume_flag=
    if [ "${export_complete:-no}" = yes ]; then
        volume_flag=--volumes
    else
        printf 'Exportação incompleta: eventual volume %s_events_data será preservado.\n' "$project" >&2
    fi
    if control down $volume_flag --remove-orphans --timeout 5 >> "$run_dir/cleanup.log" 2>&1; then
        printf 'stopped\n' > "$run_dir/environment"
    else
        printf 'cleanup-failed\n' > "$run_dir/environment"
        printf 'Não foi possível encerrar tudo. Repita: ./tg stop %s\n' "$run_id" >&2
        return 1
    fi
}

finish() {
    code=$?
    trap - EXIT INT TERM
    if [ -n "${child:-}" ]; then
        kill "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    if [ -f "$run_dir/stop-requested" ] || [ "$code" -eq 130 ] || [ "$code" -eq 143 ]; then
        outcome=CANCELLED
        code=130
    elif [ "$code" -eq 0 ]; then
        outcome=COMPLETED
    else
        outcome=FAILED
    fi
    printf '%s\n' "$outcome" > "$run_dir/status"
    if [ "$outcome" = CANCELLED ] || [ ! -f "$run_dir/environment" ] || [ "$(cat "$run_dir/environment")" != stopped ]; then
        collect
        if [ "$keep" = no ] || [ "$outcome" = CANCELLED ]; then
            shutdown || code=1
        else
            printf 'Ambiente mantido. Para encerrar: ./tg stop %s\n' "$run_id"
        fi
    fi
    printf 'Estado: %s\nResultados: %s\n' "$outcome" "$run_dir"
    if [ "$outcome" = FAILED ]; then
        printf 'Confira ./tg logs %s e os arquivos build.log/diagnostics.log.\n' "$run_id" >&2
    fi
    exit "$code"
}

run_scenario() {
    select_scenario "$1"
    keep=$2
    check_tools
    TG_READY_TIMEOUT=${TG_READY_TIMEOUT:-90}
    TG_SCENARIO_TIMEOUT=${TG_SCENARIO_TIMEOUT:-180}
    timeout_value TG_READY_TIMEOUT "$TG_READY_TIMEOUT"
    timeout_value TG_SCENARIO_TIMEOUT "$TG_SCENARIO_TIMEOUT"
    export TG_READY_TIMEOUT TG_SCENARIO_TIMEOUT
    mkdir -p "$RUNS"
    run_dir=$(mktemp -d "$RUNS/tg-$(date -u +%Y%m%d-%H%M%S)-XXXXXX")
    run_id=${run_dir##*/}
    project=$(printf '%s' "$run_id" | tr '[:upper:]' '[:lower:]')
    TG_RUN_DIR=$run_dir
    export TG_RUN_DIR
    configuration
    printf '%s\n' "$scenario" > "$run_dir/scenario"
    printf 'RUNNING\n' > "$run_dir/status"
    printf 'starting\n' > "$run_dir/environment"
    printf '%s\n' "$run_id" > "$STATE/latest.$run_id"
    mv "$STATE/latest.$run_id" "$STATE/latest"
    child=
    trap finish EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    printf 'Execução: %s\nCenário: %s\n' "$run_id" "$scenario"
    compose config --quiet 2> "$run_dir/diagnostics.log" || die 'Configuração inválida. Confira a configuração LLM quando aplicável.'
    [ "$llm" = no ] || printf 'Este cenário faz chamadas reais à LLM configurada.\n'
    printf 'Preparando imagens (o primeiro build pode demorar). Log: %s/build.log\n' "$run_dir"
    compose build $services runner > "$run_dir/build.log" 2>&1 &
    child=$!
    wait "$child" || die 'Build falhou; veja build.log.'
    child=
    [ ! -f "$run_dir/stop-requested" ] || exit 130
    printf 'Iniciando serviços em rede isolada…\n'
    compose up -d $services > "$run_dir/startup.log" 2>&1 &
    child=$!
    wait "$child" || die 'Inicialização falhou; veja startup.log.'
    child=
    [ ! -f "$run_dir/stop-requested" ] || exit 130
    printf 'running\n' > "$run_dir/environment"
    printf 'Aguardando serviços e registro dos agentes; executando cenário…\n'
    compose run --rm --no-deps -T --name "$project-runner" runner "$scenario" > "$run_dir/runner.log" 2>&1 &
    child=$!
    wait "$child" || { cat "$run_dir/runner.log"; die 'Cenário falhou ou excedeu o prazo.'; }
    child=
    cat "$run_dir/runner.log"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
    run)
        command -v uv >/dev/null 2>&1 || die 'uv é necessário para executar arquivos Python.'
        TG_RUNTIME_SOURCE="$TG_ROOT/runtime"
        TG_RUNS_DIR="$RUNS"
        export TG_RUNTIME_SOURCE TG_RUNS_DIR
        exec uv run --project "$TG_ROOT/sdk/python" python -m tg_sdk run "$@"
        ;;
    check)
        command -v uv >/dev/null 2>&1 || die 'uv é necessário para validar arquivos Python.'
        exec uv run --project "$TG_ROOT/sdk/python" python -m tg_sdk check "$@"
        ;;
    help|-h|--help) help ;;
    doctor) [ "$#" -le 1 ] || die 'Uso: ./tg doctor [cenário]'; doctor "${1:-demo}" ;;
    demo|scenario)
        if [ "$command" = demo ]; then name=demo; else
            if [ "$#" -eq 0 ]; then help; exit 0; fi
            name=$1; shift
        fi
        keep=no
        if [ "$#" -gt 0 ]; then [ "$1" = --keep ] || die 'A opção disponível é --keep.'; keep=yes; shift; fi
        [ "$#" -eq 0 ] || die 'Argumentos extras. Consulte ./tg help.'
        run_scenario "$name" "$keep"
        ;;
    logs|status|stop)
        [ "$#" -le 1 ] || die "Uso: ./tg $command [execução]"
        load_run "${1:-latest}"
        case "$command" in
            status) printf 'Execução: %s\nBackend: %s\nCenário: %s\nEstado: %s\nAmbiente: %s\nResultados: %s\n' "$run_id" "$backend" "$(cat "$run_dir/scenario")" "$(cat "$run_dir/status")" "$(cat "$run_dir/environment")" "$run_dir" ;;
            logs)
                if [ "$backend" = local-processes ]; then
                    for log in "$run_dir"/*.log "$run_dir"/*.jsonl; do
                        [ -f "$log" ] || continue
                        printf '\n%s\n' "${log##*/}"
                        tail -n 100 "$log"
                    done
                    exit 0
                fi
                for log in runner.log services.log; do
                    if [ -f "$run_dir/$log" ]; then printf '\n%s\n' "$log"; cat "$run_dir/$log"; fi
                done
                if [ "$(cat "$run_dir/environment")" != stopped ]; then
                    control logs --no-color --tail=100 || true
                fi
                ;;
            stop)
                if [ "$(cat "$run_dir/environment")" = stopped ]; then printf 'Ambiente já encerrado; resultados preservados.\n'; exit 0; fi
                [ "$backend" = docker ] || die 'Para interromper processos locais, use Ctrl+C no terminal que executa ./tg run.'
                check_tools
                if [ "$(cat "$run_dir/status")" = RUNNING ]; then
                    : > "$run_dir/stop-requested"
                    printf 'CANCELLED\n' > "$run_dir/status"
                fi
                collect
                shutdown
                printf 'Ambiente encerrado: %s\nResultados preservados: %s\n' "$run_id" "$run_dir"
                ;;
        esac
        ;;
    *) die "Comando desconhecido: $command. Consulte ./tg help." ;;
esac
