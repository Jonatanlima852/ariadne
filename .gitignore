# ── Go ────────────────────────────────────────
# Binários compilados
runtime/bin/
*.exe
*.test

# Cache de build e test
runtime/.cache/

# Vendor (dependências copiadas localmente — não usamos por ora)
runtime/vendor/

# Cobertura de testes
*.out
coverage.html

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# Ambientes virtuais
.venv/
venv/
env/

# Distribuição / empacotamento
dist/
build/
node_modules/
*.egg-info/
*.egg

# ── Código gerado pelo protoc ─────────────────
# Optamos por NÃO ignorar runtime/gen/ e sdk/python/src/
# para que o repo seja utilizável sem precisar rodar "make proto".
# Se preferir regenerar sempre, descomente as linhas abaixo:
# runtime/gen/
# sdk/python/src/contract/

# Resultados locais pertencem a cada cenário.
studies/scenarios/*/runtime_metrics/results/*
!studies/scenarios/*/runtime_metrics/results/README.md
studies/scenarios/*/benchmarks/results/*
!studies/scenarios/*/benchmarks/results/README.md
!studies/scenarios/logistics/benchmarks/results/logistics-20261004T-final-v2/

# ── Variáveis de ambiente ─────────────────────
.env
.env.*
!.env.example

